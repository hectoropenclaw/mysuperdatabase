# supanow — global GoTrue secrets (SMTP + OAuth) shared by every project.
# Copy to infra/auth-secrets.env (gitignored) and fill in. Sourced by
# provision.sh and update-auth-config.sh. Apply to a project after edits:
#   ./infra/scripts/update-auth-config.sh <ref>

# ─── SMTP (Resend: user is literally "resend", pass is the API key) ───
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx
SMTP_ADMIN_EMAIL=noreply@hconsulting.mx
SMTP_SENDER_NAME="H Consulting"

# ─── OAuth: Google social login ───
# Add https://<ref>.db.hconsulting.app/auth/v1/callback to the Google Cloud
# OAuth client's Authorized redirect URIs for each project.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOTRUE_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxx
